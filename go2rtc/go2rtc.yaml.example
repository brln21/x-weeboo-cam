# Salin ke go2rtc/go2rtc.yaml (di-.gitignore, JANGAN commit - berisi token akun Xiaomi).
# Jalankan: go2rtc -config go2rtc/go2rtc.yaml

api:
  # WAJIB localhost. WebUI go2rtc bisa edit config & lihat token; jangan pernah dibuka ke luar.
  # Browser user tidak bicara ke sini - semua lewat backend (server/).
  listen: "127.0.0.1:1984"

rtsp:
  listen: "127.0.0.1:8554"

webrtc:
  # Jalur media WebRTC (signaling-nya tetap lewat backend/tunnel).
  # Tanpa port-forward, WebRTC dari luar rumah bisa gagal; player otomatis fallback ke MSE.
  listen: ":8555"
  candidates:
    - stun:8555

xiaomi:
  # Terisi otomatis setelah login lewat WebUI go2rtc (buka http://127.0.0.1:1984 di laptop server).
  "<ACCOUNT_ID>": "V1:<TOKEN>"

streams:
  # Koneksi mentah ke kamera (H.265 + audio PCMA). App TIDAK memakai stream ini langsung.
  Xiaomi_raw:
    - xiaomi://<ACCOUNT_ID>:<REGION>@<CAMERA_IP>?did=<DID>&model=<MODEL>

  # Stream yang dipakai app (GO2RTC_STREAM=Xiaomi): H.264 + Opus hasil transcode.
  # SENGAJA dipisah dari Xiaomi_raw. Kalau source xiaomi:// dan ffmpeg: ada di stream yang sama,
  # go2rtc menyambung ke kamera dulu (untuk audio) lalu menunggu ffmpeg siap. Selama menunggu,
  # antrean data kamera penuh dan koneksinya putus ("cs2: pop buffer is full").
  # Kalau CPU Intel gen 6+ (Skylake) tambahkan #hardware supaya transcode pakai QuickSync.
  Xiaomi:
    - "ffmpeg:Xiaomi_raw#video=h264#audio=opus"
