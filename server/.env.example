# Salin ke server/.env lalu isi. File .env TIDAK di-commit.

# Port backend. cloudflared diarahkan ke sini (http://localhost:3000), BUKAN ke go2rtc.
PORT=3000
# Bind ke localhost saja; akses publik lewat Cloudflare Tunnel.
HOST=127.0.0.1

# Alamat go2rtc (harus bind localhost juga, lihat go2rtc/go2rtc.yaml.example).
GO2RTC_URL=http://127.0.0.1:1984
# Nama stream di go2rtc. Dipaksa di server; client tidak bisa pilih stream lain.
GO2RTC_STREAM=Xiaomi

# Random string panjang (min 32 karakter). Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Lama sesi login (jam).
SESSION_TTL_HOURS=12

# true kalau diakses lewat HTTPS (Cloudflare). false hanya untuk dev di http://localhost.
COOKIE_SECURE=false

# Origin yang boleh buka WebSocket stream, pisah koma. Kosong = hanya origin yang sama dengan Host.
# Contoh produksi: https://cam.domainmu.com
ALLOWED_ORIGINS=

# File user (dibuat oleh `npm run user:add`).
USERS_FILE=./users.json

# PTZ: go2rtc BELUM menyediakan API PTZ untuk kamera Xiaomi.
#   none = tombol PTZ disembunyikan
#   exec = jalankan program eksternal per gerakan (lihat scripts/ptz-template.py)
PTZ_DRIVER=none
# Program + argumen (JSON array). {direction} diganti up/down/left/right.
PTZ_EXEC=python
PTZ_EXEC_ARGS=["scripts/ptz-template.py","{direction}"]
